                                                                                                                                                                                                                                            
 {                                                                                                                                                                                                                                          
     "name": "ricci69/ultimatemysql",                                                                                                                                                                                                       
     "type": "library",                                                                                                                                                                                                                     
     "description": "Ultimate MySQL Wrapper Class for PHP 8.1+",                                                                                                                                                                            
     "keywords": ["mysql", "database", "wrapper", "mysqli", "prepared-statements"],                                                                                                                                                         
     "homepage": "https://github.com/ricci69/ultimatemysql",                                                                                                                                                                                
     "license": "MIT",                                                                                                                                                                                                                      
     "require": {                                                                                                                                                                                                                           
         "php": ">=8.1",                                                                                                                                                                                                                    
         "ext-mysqli": "*"                                                                                                                                                                                                                  
     },                                                                                                                                                                                                                                     
     "autoload": {                                                                                                                                                                                                                          
         "files": ["mysql.class.php"]                                                                                                                                                                                                       
     },                                                                                                                                                                                                                                     
     "require-dev": {                                                                                                                                                                                                                       
         "phpunit/phpunit": "^10.0",                                                                                                                                                                                                        
         "squizlabs/php_codesniffer": "^3.11",                                                                                                                                                                                               
         "vimeo/psalm": "^5.0",                                                                                                                                                                                                             
         "phpstan/phpstan": "^1.10"                                                                                                                                                                                                         
     },                                                                                                                                                                                                                                     
     "config": {                                                                                                                                                                                                                            
         "allow-plugins": {                                                                                                                                                                                                                 
             "dealerdirect/phpcodesniffer-composer-installer": true                                                                                                                                                                         
         },                                                                                                                                                                                                                                 
         "sort-packages": true                                                                                                                                                                                                              
     }                                                                                                                                                                                                                                      
 } 
