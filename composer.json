{
    "name": "ricci69/ultimatemysql",
    "type": "library",
    "description": "MySQL database access wrapper compatible with PHP 8.1+",
    "keywords": ["mysql","php","database"],
    "homepage": "https://github.com/ricci69/ultimatemysql",
    "license": "MIT",
    "version": "5.0",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1",
        "symfony/console": "^6.4"
    },    
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "9.5.*",
        "squizlabs/php_codesniffer": "^3.5",
        "escapestudios/symfony2-coding-standard": "^3.9",
        "vimeo/psalm": "^3.11|^4.0",
        "doctrine/instantiator": "1.5.0",
        "phpstan/phpstan": "^2.2"
    }
}
